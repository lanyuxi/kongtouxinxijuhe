{
  "name": "dropscope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "空投情报平台 — Web3 空投情报与决策助手",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/api/dev.mjs",
    "start": "node --env-file-if-exists=.env --import tsx scripts/api/server.ts --production",
    "build": "npm run ensure-logos && npm run sync-data && npm run feed && node scripts/publication.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "sync-data": "node scripts/sync-data.mjs",
    "pipeline": "tsx scripts/pipeline.ts",
    "repair:p0": "node --import tsx scripts/rebuild-p0.ts",
    "test": "vitest run",
    "validate": "tsx scripts/validate.ts && node scripts/i18n/check-human-fix.mjs --strict",
    "logos": "node scripts/logo/fetch-logos.mjs",
    "ensure-logos": "node scripts/lib/ensure-logos.mjs",
    "feed": "tsx scripts/build-feed.ts",
    "i18n:cache": "node scripts/i18n/build-cache.mjs --report",
    "i18n:queue": "node scripts/i18n/review-queue.mjs",
    "rebuild:data": "node --import tsx scripts/rebuild-p0.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.63.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
